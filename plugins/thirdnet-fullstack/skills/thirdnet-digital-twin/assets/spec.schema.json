{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://thirdnet/skills/thirdnet-digital-twin/spec.schema.json",
  "title": "Park Spec",
  "description": "v1.9 — 园区数字孪生规格说明 schema。与 references/park-spec.md 对齐；scripts/validate_spec.py 在 jsonschema 结构校验之上再叠加业务规则（garage 至多一栋、legend category ∈ 已知集、POI 坐标范围、v1.9 主题防黑屏块完整性等）。v1.9 新增的 scene/ground/ambientFloor 块位于各 assets/themes/*.tokens.json（事实来源），spec.tokens 仅支持标量覆盖。IDE 可用 '$schema' 指向本文件做自动补全。",
  "type": "object",
  "required": ["title", "buildings"],
  "additionalProperties": false,
  "properties": {
    "title": { "type": "string", "minLength": 1 },
    "style": {
      "type": "string",
      "enum": ["cyber", "realistic", "night-realistic", "blueprint", "holographic", "white-model", "isometric"]
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "tokens": {
      "type": "object",
      "description": "颜色覆盖（键名须命中所选 style 的 *.tokens.json 键，否则 validate_spec.py WARN 拼写错误）。",
      "additionalProperties": { "type": ["string", "number", "null"] }
    },
    "shaders": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "grid": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["u_gridColor", "u_cell", "u_strength"],
              "additionalProperties": false,
              "properties": {
                "u_gridColor": { "type": "string" },
                "u_cell": { "type": "number", "exclusiveMinimum": 0 },
                "u_strength": { "type": "number", "minimum": 0 }
              }
            }
          ]
        }
      }
    },
    "floorHeight": { "type": "number", "exclusiveMinimum": 0 },
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "x": { "type": "number", "exclusiveMinimum": 0 },
        "z": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "buildings": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/building" }
    },
    "legend": {
      "type": "array",
      "items": { "$ref": "#/$defs/legendEntry" }
    },
    "switcher": {
      "type": "array",
      "description": "v1.8 推荐用对象数组 {id,label?}（id 显式对齐 buildings[].id）；裸字符串数组仍兼容。",
      "items": {
        "oneOf": [
          { "type": "string" },
          {
            "type": "object",
            "required": ["id"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string" },
              "label": { "type": "string" }
            }
          }
        ]
      }
    },
    "environment": { "$ref": "#/$defs/environment" },
    "pois": {
      "type": "array",
      "items": { "$ref": "#/$defs/poi" }
    },
    "cameraTour": { "$ref": "#/$defs/cameraTour" }
  },
  "$defs": {
    "category": { "type": "string", "enum": ["building", "garage"] },
    "building": {
      "type": "object",
      "required": ["id", "name", "category", "w", "d", "x", "z"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "category": { "$ref": "#/$defs/category" },
        "w": { "type": "number", "exclusiveMinimum": 0 },
        "d": { "type": "number", "exclusiveMinimum": 0 },
        "floors": { "type": "number", "exclusiveMinimum": 0 },
        "x": { "type": "number" },
        "z": { "type": "number" },
        "facing": { "type": "string", "enum": ["N", "S", "E", "W"] },
        "header": { "type": "string" },
        "highlightedFloor": { "type": "integer", "minimum": 0 }
      }
    },
    "legendEntry": {
      "type": "object",
      "required": ["label", "category", "color"],
      "additionalProperties": false,
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "category": { "$ref": "#/$defs/category" },
        "color": { "type": "string" }
      }
    },
    "poi": {
      "type": "object",
      "required": ["id", "type", "label", "x", "z"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "enum": ["entrance", "exit", "camera", "gate", "service", "landmark", "parking", "custom"] },
        "label": { "type": "string", "minLength": 1 },
        "x": { "type": "number" },
        "z": { "type": "number" },
        "y": { "type": "number" },
        "buildingId": { "type": "string" },
        "floorIndex": { "type": "integer", "minimum": 0 },
        "tooltip": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "title": { "type": "string" },
            "description": { "type": "string" },
            "meta": { "type": "object", "additionalProperties": { "type": "string" } }
          }
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "internalRoads": { "type": "string", "enum": ["loop", "cross", "grid", "none"] },
        "surfaceParking": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["stalls"],
              "additionalProperties": false,
              "properties": {
                "stalls": { "type": "number", "exclusiveMinimum": 0 },
                "occupied": { "type": "number", "minimum": 0 }
              }
            }
          ]
        },
        "greenery": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "treeDensity": { "type": "string", "enum": ["sparse", "normal", "lush"] },
            "centralPlaza": { "type": "boolean" },
            "waterFeature": { "type": "boolean" }
          }
        },
        "surrounding": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "roads": { "type": "boolean" },
            "sidewalk": { "type": "boolean" },
            "wall": { "type": "boolean" },
            "gate": { "type": "boolean" }
          }
        },
        "ambiance": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "streetLamps": { "type": "boolean" },
            "groundGlow": { "type": "boolean" },
            "vehicles": { "type": "boolean" }
          }
        }
      }
    },
    "cameraTour": {
      "type": "object",
      "description": "v2.2 航拍巡航（auto-orbit 展示）配置；全可选，缺省即智能默认（详见 references/park-spec.md「相机巡航」与 scene-recipe.md §13）。",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "description": "首屏自动开启巡航（默认 false——用户点 TourToggleButton 触发）" },
        "speed": { "type": "number", "exclusiveMinimum": 0, "description": "OrbitControls autoRotateSpeed（度/帧），默认 0.6 缓慢" },
        "elevation": { "type": "number", "minimum": 0, "maximum": 1.5708, "description": "巡航相机俯角（弧度，above-horizon；默认 1.0≈57° 鸟瞰；运行时钳到 OrbitControls polar[0.5,1.3] 内）" },
        "framingK": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1, "description": "巡航取景内容占比（默认 0.55 俯瞰全城；默认取景 K=0.66）" },
        "pauseOnInteract": { "type": "boolean", "description": "用户拖拽自动退出巡航、把控制权还给用户（默认 true）" }
      }
    }
  }
}
