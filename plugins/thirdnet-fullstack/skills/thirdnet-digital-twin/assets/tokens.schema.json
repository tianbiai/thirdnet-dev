{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://thirdnet/skills/thirdnet-digital-twin/tokens.schema.json",
  "title": "Theme Tokens v2.1",
  "description": "结构契约：assets/themes/*.tokens.json 的形状校验。validate_spec.py 加载本文件对所选风格 token 做结构校验——缺关键块或类型错 → FAIL。允许 key 带下划线前缀的注释字段（_comment 等），不参与校验。v2.0 新增 realism 块（写实增强旋钮：material/bloom/ao/reflection/fog/sun）。v2.1 新增 scene.sky（程序化天空开关）、environment.roadMarking/water/rooftop（标线/水景/楼顶设备色）、ui 块（2D 组件观感旋钮，assets/components/ 消费）。v2.5 新增可选 realism.shadow（软阴影 radius/bias），并恢复 realistic/night-realistic 两风格（写实引擎 envMap/GTAO/反射/软阴影/雾 全部激活）。v2.6 新增可选 underground 块（地下场景配色：deck/wall/edge/room/spot/ramp + deckOpacity/wallOpacity）。v2.15 新增可选 windows 块（夜间发光窗流水线：逐层窗列数/分层点亮率/暖冷双辉光/dirty-gated 翻转动画，仅 night-realistic 消费；缺省走 park-scene.impl.ts 内置 DEFAULT_WINDOWS；animRatio=0 退化为静态烘焙=与 v2.14 行为一致）。",
  "type": "object",
  "additionalProperties": true,
  "required": ["scene", "palette", "category", "building", "lights", "environment", "realism", "ui"],
  "properties": {
    "scene": {
      "type": "object",
      "description": "v1.9 顶→底纵向渐变 CanvasTexture 背景色（防黑屏）。v2.1 新增 sky 子块。",
      "required": ["bgTop", "bgBottom", "sky"],
      "properties": {
        "bgTop": { "type": "string" },
        "bgBottom": { "type": "string" },
        "sky": {
          "type": "object",
          "description": "v2.1 程序化天空元素开关（画进背景纹理，零运行时成本，种子确定性）。",
          "required": ["clouds", "stars", "moon"],
          "properties": {
            "clouds": { "type": "boolean" },
            "stars": { "type": "boolean" },
            "moon": { "type": "boolean" }
          }
        }
      }
    },
    "palette": {
      "type": "object",
      "required": ["void-bg", "cyan", "cyan-bright", "cyan-dim", "magenta", "magenta-bright", "magenta-dim", "mint"],
      "additionalProperties": { "type": "string" }
    },
    "accents": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "category": {
      "type": "object",
      "required": ["building", "garage"],
      "properties": {
        "building": { "type": "string" },
        "garage": { "type": "string" }
      }
    },
    "building": {
      "type": "object",
      "required": ["roomShade", "dividerColor"],
      "properties": {
        "roomShade": { "type": "number", "minimum": 0, "maximum": 1 },
        "dividerColor": { "type": "string" },
        "edgeColor": { "type": "string", "description": "v2.17 立体轮廓线色（EdgesGeometry silhouette）。缺省回退 dividerColor。暗背景风格（夜景等）配淡色让楼幢轮廓在暗天空下可辨；逐层虚线分隔仍用 dividerColor。" }
      }
    },
    "realism": {
      "type": "object",
      "description": "v2.0 写实增强旋钮（park-scene.impl.ts 消费）。所有风格都必须有此块——非写实风格把 bloom.strength=0 / ao.enabled=false / reflection.enabled=false / fog=null 显式关闭，纪律不破。v2.19：写实两风格 envMap 改用 public/sky.hdr（CC0 HDRI，户外天水 IBL，替代 RoomEnvironment）；composer 全风格加 SMAAPass 抗锯齿；exposure 数据化；pbr 楼体升级 MeshPhysicalMaterial 消费 material.clearcoat/clearcoatRoughness。",
      "required": ["material", "bloom", "ao", "reflection", "fog", "sun"],
      "properties": {
        "material": {
          "type": "object",
          "required": ["roughness", "metalness", "envMapIntensity"],
          "properties": {
            "roughness": { "type": "number", "minimum": 0, "maximum": 1 },
            "metalness": { "type": "number", "minimum": 0, "maximum": 1 },
            "envMapIntensity": { "type": "number", "minimum": 0, "maximum": 3 },
            "clearcoat": { "type": "number", "minimum": 0, "maximum": 1, "description": "v2.19 可选。玻璃幕墙 clearcoat 漆面反射强度（仅 pbr 楼体走 MeshPhysicalMaterial 消费；写实风格建议 0.5–0.9）。缺省 0.7。" },
            "clearcoatRoughness": { "type": "number", "minimum": 0, "maximum": 1, "description": "v2.19 可选。clearcoat 粗糙度。缺省 0.25。" }
          }
        },
        "exposure": { "type": "number", "minimum": 0, "maximum": 8, "description": "v2.19 可选。ACES tone mapping 曝光（applyProfile 优先读此值，缺省回退 PROFILES.toneExposure）。夜景主杠杆。" },
        "bloom": {
          "type": "object",
          "description": "UnrealBloomPass 参数；strength=0 表示关闭 composer。",
          "required": ["threshold", "strength", "radius"],
          "properties": {
            "threshold": { "type": "number", "minimum": 0, "maximum": 1 },
            "strength": { "type": "number", "minimum": 0, "maximum": 3 },
            "radius": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        "ao": {
          "type": "object",
          "description": "GTAO 接触/环境光遮蔽；v2.5 写实两风格启用（enabled=true），其余 2 风格 false。",
          "required": ["enabled", "intensity", "radius"],
          "properties": {
            "enabled": { "type": "boolean" },
            "intensity": { "type": "number", "minimum": 0, "maximum": 2 },
            "radius": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        "reflection": {
          "type": "object",
          "description": "地面湿润反射（Reflector）；v2.5 night-realistic 启用，其余风格 false。",
          "required": ["enabled", "opacity", "mixStrength"],
          "properties": {
            "enabled": { "type": "boolean" },
            "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
            "mixStrength": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        "fog": {
          "description": "线性雾；null 表示关闭。",
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["color", "near", "far"],
              "properties": {
                "color": { "type": "string" },
                "near": { "type": "number", "minimum": 0 },
                "far": { "type": "number", "minimum": 0 }
              }
            }
          ]
        },
        "sun": {
          "type": "object",
          "description": "太阳/月光方位（颜色与强度仍走 lights.sun/sunIntensity）。azimuth/elevation 单位为度。",
          "required": ["azimuth", "elevation"],
          "properties": {
            "azimuth": { "type": "number", "minimum": 0, "maximum": 360 },
            "elevation": { "type": "number", "minimum": 0, "maximum": 90 }
          }
        },
        "shadow": {
          "type": "object",
          "description": "v2.5 软阴影旋钮（可选；仅写实两风格 profile.shadows=true 时生效）。缺省时引擎用 radius=4 / bias=-0.0003。",
          "properties": {
            "radius": { "type": "number", "minimum": 0, "maximum": 16 },
            "bias": { "type": "number", "minimum": -0.01, "maximum": 0.01 }
          }
        }
      }
    },
    "lights": {
      "type": "object",
      "required": ["sunIntensity", "hemiIntensity", "ambientIntensity", "ambientFloor", "pointIntensity", "pointDistance"],
      "properties": {
        "sun": { "type": ["string", "null"] },
        "sunIntensity": { "type": "number", "minimum": 0 },
        "hemiSky": { "type": ["string", "null"] },
        "hemiGround": { "type": ["string", "null"] },
        "hemiIntensity": { "type": "number", "minimum": 0 },
        "ambient": { "type": ["string", "null"] },
        "ambientIntensity": { "type": "number", "minimum": 0 },
        "ambientFloor": { "type": "number", "minimum": 0 },
        "point": { "type": ["string", "null"] },
        "pointIntensity": { "type": "number", "minimum": 0 },
        "pointDistance": { "type": "number", "minimum": 0 }
      }
    },
    "ground": {
      "type": "object",
      "properties": {
        "texture": {
          "type": "object",
          "required": ["type", "base", "line", "cell"],
          "properties": {
            "type": { "type": "string", "enum": ["tiles", "grid", "dots"] },
            "base": { "type": "string" },
            "line": { "type": "string" },
            "cell": { "type": "number", "minimum": 1 }
          }
        }
      }
    },
    "shaders": {
      "type": "object",
      "properties": {
        "grid": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["u_gridColor", "u_cell", "u_strength"],
              "properties": {
                "u_gridColor": { "type": "string" },
                "u_cell": { "type": "number", "minimum": 1 },
                "u_strength": { "type": "number", "minimum": 0 }
              }
            }
          ]
        }
      }
    },
    "environment": {
      "type": "object",
      "required": ["city-ground", "groundGlow", "road", "roadLine", "sidewalk", "grass", "treeTrunk", "treeCanopy", "lampGlow", "vehicle", "roadMarking", "water", "rooftop"],
      "properties": {
        "city-ground": { "type": "string" },
        "groundGlow": { "type": "boolean" },
        "road": { "type": "string" },
        "roadLine": { "type": "string" },
        "sidewalk": { "type": "string" },
        "grass": { "type": "string" },
        "treeTrunk": { "type": "string" },
        "treeCanopy": { "type": "string" },
        "lampGlow": { "type": "string" },
        "vehicle": { "type": "string" },
        "roadMarking": { "type": "string", "description": "v2.1 内部道路中央虚线/斑马线/转向箭头色。" },
        "water": { "type": "string", "description": "v2.1 水景水面色。" },
        "rooftop": { "type": "string", "description": "v2.1 楼顶电梯机房/天线设备色。" }
      }
    },
    "garageEntrance": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "surfaceParking": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "underground": {
      "type": "object",
      "description": "v2.6 地下场景配色（§14 地下车库多层剖面）。park-scene.impl.ts buildUnderground 消费——地面不开洞，坑体为 Y<0 透明玻璃柱：底板半透明自发光 + 4 面玻璃墙。所有风格都应有此块（非写实风格走自发光；写实风格走 PBR 受光）。deck/wall/edge/room/spot/ramp 为 hex；deckEmissive 为 hex（底板自发光色，写实日景可给极暗色近关）；deckOpacity/wallOpacity 为 0–1 不透明度。",
      "required": ["deck", "deckEmissive", "deckOpacity", "wall", "wallOpacity", "edge", "room", "spot", "ramp"],
      "properties": {
        "deck": { "type": "string" },
        "deckEmissive": { "type": "string" },
        "deckOpacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "wall": { "type": "string" },
        "wallOpacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "edge": { "type": "string" },
        "room": { "type": "string" },
        "spot": { "type": "string" },
        "ramp": { "type": "string" }
      }
    },
    "windows": {
      "type": "object",
      "description": "v2.15 夜间发光窗流水线（仅 night-realistic 实际消费；realistic 日景可选静默）。animRatio=0 → 退化为静态烘焙发光窗（与 v2.14 行为一致）。缺省整个块时，pbr-night 走 park-scene.impl.ts 内置 DEFAULT_WINDOWS（litRatio 0.38/0.22/0、warm #ffd989 70%、cool #bfe2ff 30%、glassOff #0c2240、animRatio 0.2、fade 800ms、flip 3000+8000ms）。换肤改本块即可调整夜间窗光气质。",
      "properties": {
        "roomsAxisTower": { "type": "integer", "minimum": 2, "maximum": 12, "description": "塔体立面窗列数（cellW=padW/rooms，winW=cellW*0.5）。默认 3。" },
        "roomsAxisPodium": { "type": "integer", "minimum": 2, "maximum": 12, "description": "裙楼长面窗列数（预留；当前 facade 仅绘塔体）。默认 5。" },
        "litRatio": {
          "type": "object",
          "description": "分层点亮率：底层（商业/大堂夜间暗）、中层（最密）、顶层（住宅较稀）。注意 BoxGeometry flipY：canvas 行 0=顶层、行 rows-1=底层。",
          "required": ["ground", "middle", "top"],
          "properties": {
            "ground": { "type": "number", "minimum": 0, "maximum": 1 },
            "middle": { "type": "number", "minimum": 0, "maximum": 1 },
            "top": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        "warmColor": { "type": "string", "description": "亮窗暖辉光色（多数）。" },
        "coolColor": { "type": "string", "description": "亮窗冷辉光色（少数）。" },
        "warmRatio": { "type": "number", "minimum": 0, "maximum": 1, "description": "亮窗中暖色占比，默认 0.7。" },
        "glassOff": { "type": "string", "description": "未亮窗玻璃色（绘于 albedo facade，非发光图）。" },
        "gradient": {
          "type": "object",
          "description": "albedo facade 墙面纵向渐变（顶→底），替代单色墙。",
          "required": ["top", "bottom"],
          "properties": {
            "top": { "type": "string" },
            "bottom": { "type": "string" }
          }
        },
        "animRatio": { "type": "number", "minimum": 0, "maximum": 1, "description": "0=静态烘焙；>0=此比例的窗户参与开关翻转动画（dirty-gated 局部重绘 emissiveMap，reduced-motion 自动关闭）。" },
        "fadeMs": { "type": "integer", "minimum": 0, "description": "单窗开关 smoothstep 渐隐时长 ms。" },
        "flipMinMs": { "type": "integer", "minimum": 0, "description": "同一窗两次翻转最小间隔 ms。" },
        "flipVarMs": { "type": "integer", "minimum": 0, "description": "翻转间隔随机附加范围 ms（错峰）。" },
        "emissiveIntensity": { "type": "number", "minimum": 0, "maximum": 4, "description": "覆盖默认 1.3。" },
        "seedSalt": { "type": "string", "description": "可选；混入 hashStr 种子让多园区发光图案各异。" }
      }
    },
    "poi": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {
          "type": "object",
          "required": ["online", "offline", "alarm", "idle"],
          "additionalProperties": { "type": "string" }
        }
      },
      "additionalProperties": { "type": "string" }
    },
    "ui": {
      "type": "object",
      "description": "v2.1 2D 组件观感旋钮（assets/components/ 消费，generate_theme.py 派生 --twin-ui-* CSS 变量）。赛博发光强，等距克制（glowStrength 0 → 组件退化为中性投影）。",
      "required": ["panelOpacity", "panelBlur", "panelRadius", "glowStrength", "glowColor", "borderWidth", "labelBg", "labelText", "switcherStyle"],
      "properties": {
        "panelOpacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "panelBlur": { "type": "number", "minimum": 0, "maximum": 30 },
        "panelRadius": { "type": "number", "minimum": 0, "maximum": 24 },
        "glowStrength": { "type": "number", "minimum": 0, "maximum": 1 },
        "glowColor": { "type": "string" },
        "borderWidth": { "type": "number", "minimum": 0, "maximum": 4 },
        "labelBg": { "type": "string" },
        "labelText": { "type": "string" },
        "switcherStyle": { "type": "string", "enum": ["neon", "flat"] },
        "selectionBorder": { "type": "string", "description": "v2.3 选中楼层边框色 #hex（updateSelectionColors 读取；缺省回退 FLOOR_HIGHLIGHT_COLOR）" },
        "selectionFill": { "type": "string", "description": "v2.3 选中楼层 4 立面填充色 #hex（缺省回退 FLOOR_FILL_COLOR）" },
        "selectionFillOpacity": { "type": "number", "minimum": 0, "maximum": 1, "description": "v2.3 填充不透明度（缺省 0.4）" }
      }
    },
    "fonts": {
      "type": "object",
      "required": ["zh", "latin"],
      "properties": {
        "zh": { "type": "string" },
        "latin": { "type": "string" }
      }
    }
  }
}
