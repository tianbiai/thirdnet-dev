    "bloom": { "threshold": 0.6, "strength": 0.5, "radius": 0.5 },
    "ao": { "enabled": true, "intensity": 1.1, "radius": 0.5 },
    "reflection": { "enabled": true, "opacity": 0.85, "mixStrength": 0.6 },
    "fog": { "color": "#0a1428", "near": 600, "far": 1800 },
    "sun": { "azimuth": 200, "elevation": 60 },
    "shadow": { "radius": 4, "bias": -0.0004 }
  },
