  "category": {
    "_comment": "写实楼栋按类别上色：building=建筑钢/混凝土灰蓝（facade 纹理叠细节），garage=自然绿。",
    "building": "#7d8896",
    "garage": "#4a9d7a"
  },
  "underground": {
    "_comment": "v2.6 地下场景配色（§14）。写实日景：PBR 受光材质，弱自发光（靠日光 + 环境贴图照明，与楼上 realistic 同引擎）。底板近不透明混凝土深灰蓝、墙淡玻璃、边界/功能间去饱和绿/琥珀。",
    "deck": "#1a2436",
    "deckEmissive": "#0a0e16",
    "deckOpacity": 0.5,
    "wall": "#7fa8d0",
    "wallOpacity": 0.16,
    "edge": "#3aa68a",
    "room": "#e09a2b",
    "spot": "#e8eef5",
    "ramp": "#2a3340"
  },
  "building": {
    "_comment": "写实立面：roomShade 收小（去卡通强对比），dividerColor=窗框深线（facade 纹理画真实窗户网格 + 日间玻璃反光）。",
    "roomShade": 0.1,
    "dividerColor": "#5a6470"
  },
  "lights": {
    "_comment": "日间自然光：暖金时段 DirectionalLight（高强度、低角度长投影）+ 天空/地面 HemisphereLight；ambientFloor 兜底消除死黑。不开 PointLight（写实日间靠太阳 + 环境贴图）。",
    "sun": "#fff4e0",
    "sunIntensity": 1.4,
    "hemiSky": "#bcd4ef",
    "hemiGround": "#5a5040",
    "hemiIntensity": 0.6,
    "ambient": null,
    "ambientIntensity": 0.0,
    "ambientFloor": 0.25,
    "point": null,
    "pointIntensity": 0.0,
    "pointDistance": 0.0
  },
  "ground": {
    "_comment": "写实地面：沥青灰 tiles 程序化纹理（CanvasTexture），接受软阴影与 AO。",
    "texture": { "type": "tiles", "base": "#3a3e44", "line": "#c8ccd0", "cell": 60 }
