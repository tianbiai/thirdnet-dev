  "effects": {
    "_comment": "v2.28 动效层旋钮（realistic = 日间高级；particles + water 启用做日间氛围；scan/dataFlow/pillars/lampCones/godRays/stars/fog/scanlines/gridPulse 关）。",
    "scan":       { "enabled": false },
    "dataFlow":   { "enabled": false },
    "pillars":    { "enabled": false },
    "particles":  { "enabled": true,  "color": "#ffffff", "count": 70,  "spread": 360, "size": 1.4 },
    "lampCones":  { "enabled": false },
    "godRays":    { "enabled": false },
    "stars":      { "enabled": false },
    "water":      { "enabled": true,  "color": "#3a6fb0", "normalScale": 1.2, "periodMs": 4000 },
    "fog":        { "enabled": false },
    "scanlines":  { "enabled": false, "opacity": 0, "periodMs": 0 },
    "gridPulse":  { "enabled": false, "speed": 0, "wavelength": 0 }
  },
  "realism": {
    "_comment": "v2.19 日间写实：真实 HDRI 天空 IBL（户外反射与天空方向/色温一致，替代 RoomEnvironment）+ 玻璃幕墙 clearcoat + GTAO 接触阴影 + 更柔更长软阴影 + 轻雾做大气透视；bloom 极弱。曝光数据化（realism.exposure）。",
    "exposure": 1.0,
    "material": { "roughness": 0.18, "metalness": 0.05, "envMapIntensity": 2.0, "clearcoat": 0.9, "clearcoatRoughness": 0.3 },
    "bloom": { "threshold": 0.85, "strength": 0.12, "radius": 0.4 },
    "ao": { "enabled": true, "intensity": 1.0, "radius": 0.5 },
    "reflection": { "enabled": false, "opacity": 0.5, "mixStrength": 0.5 },
    "fog": null,
    "sun": { "azimuth": 150, "elevation": 38 },
    "shadow": { "radius": 7, "bias": -0.0003 }
  },
  "ui": {
    "_comment": "写实 2D chrome：克制——半透浅底 + 细描边 + 极弱发光（glowStrength 0.1）+ flat 切换器。与日间自然气质一致，不抢 3D 主体。",
